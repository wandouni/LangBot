# Copy to .env on the production host and edit before the first start.
# Never commit the real .env.

# ---- Images ----
# Built by build-image.sh / ship-image.sh and loaded offline by ship-image.sh.
LANGBOT_IMAGE=langbot:4.11.2-CHANGEME
SQLBOT_IMAGE=sqlbot:CHANGEME
PORTAL_GATEWAY_IMAGE=langbot-portal-gateway:CHANGEME

# Persistent data directories, relative to this compose file.
LANGBOT_DATA_DIR=./data
SQLBOT_DATA_DIR=./sqlbot-data
TZ=Asia/Shanghai

# ---- Public entry point ----
# The gateway owns the browser-facing port. LangBot stays on loopback and
# SqlBot stays on the compose network, so both URLs must be served by the
# gateway: http://<host>:5300/ and http://<host>:5300/sqlbot/.
GATEWAY_HTTP_PORT=5300
LANGBOT_INTERNAL_PORT=5301
# Browser-facing origin, no trailing slash. It must match what is registered
# with the CAS identity platform, and it drives Secure cookie decisions.
PUBLIC_ORIGIN=http://10.8.16.56:5300

# ---- Application center ----
# Enable after the gateway and SqlBot are healthy, then verify both entries.
# PORTAL_ENABLED=false restores the legacy "login -> /home" flow.
PORTAL_ENABLED=true
PORTAL_SQLBOT_ENABLED=true

# ---- LangBot ----
# Public origin used for platform webhooks and the embed widget. Keep it equal
# to PUBLIC_ORIGIN so links generated by the backend stay reachable.
LANGBOT_WEBHOOK_PREFIX=http://10.8.16.56:5300

# Optional global service API key for HTTP API / MCP access.
LANGBOT_GLOBAL_API_KEY=

# ---- CAS 2.0 / Unified Identity Authentication ----
# Leave disabled until the identity platform has whitelisted the callback:
#   {SSO_CAS_SERVICE_BASE_URL}/api/v1/user/sso/cas/callback
# The base URL must be the browser-facing origin (no path), and the browser
# must open LangBot on exactly this host (localhost != 127.0.0.1).
SSO_CAS_ENABLED=false
# CAS server root including its context path, for example:
# https://sso.lnc.edu.cn/lyuapServer
SSO_CAS_BASE_URL=
# Public origin of this WebUI (protocol + host + port, no path). With the
# gateway it is PUBLIC_ORIGIN, not the internal 5301 port.
SSO_CAS_SERVICE_BASE_URL=http://10.8.16.56:5300
# HMAC secret for the one-time state cookie. Generate with:
# openssl rand -hex 32
SSO_CAS_STATE_SECRET=
# Comma separated CAS usertype values; a missing usertype is always rejected.
SSO_CAS_ALLOWED_USER_TYPES=teacher

# Control WebSocket secret shared by core and the plugin runtime.
# Generate with: openssl rand -hex 32
LANGBOT_PLUGIN_RUNTIME_CONTROL_TOKEN=

# Offline plugin dependency index served on the host (see make-wheelhouse.sh).
# Leave empty if no plugin needs to install Python dependencies.
LANGBOT_PLUGIN_PYPI_INDEX_URL=http://192.168.31.66:8081/simple
LANGBOT_PLUGIN_PYPI_TRUSTED_HOST=192.168.31.66

# Process-wide blocking-work budgets.
LANGBOT_BLOCKING_EXECUTOR_MAX_WORKERS=8
LANGBOT_BLOCKING_EXECUTOR_MAX_PENDING=128
LANGBOT_BLOCKING_EXECUTOR_MAX_INFLIGHT_PER_SCOPE=4

# ---- SqlBot ----
# Internal address and mount point. CONTEXT_PATH must stay /sqlbot so the
# gateway (which keeps the prefix) and the SPA agree.
SQLBOT_BASE_URL=http://sqlbot:8000
SQLBOT_CONTEXT_PATH=/sqlbot
SQLBOT_LOG_LEVEL=INFO

# SqlBot application secret. Generate with: openssl rand -hex 32
SQLBOT_SECRET_KEY=
# Password for the embedded PostgreSQL database. Use a strong value; it is
# only reachable from inside the container.
SQLBOT_POSTGRES_PASSWORD=
# Initial password assigned to imported/created local accounts.
SQLBOT_DEFAULT_PWD=

# ---- LangBot -> SqlBot single sign-on ----
# Shared HMAC secret used by both services. Generate with:
# openssl rand -hex 32
SQLBOT_SSO_ENABLED=true
SQLBOT_SSO_SHARED_SECRET=
SQLBOT_SSO_TICKET_TTL_SECONDS=60
SQLBOT_SSO_TOKEN_TTL_MINUTES=480
# SqlBot workspace assigned to auto-created accounts.
SQLBOT_SSO_DEFAULT_WORKSPACE_ID=1
