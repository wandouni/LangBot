# Copy to .env and fill in the values for this machine. Never commit .env.
#
# This stack reproduces the production layout on a developer machine:
#   http://<GATEWAY_LAN_IP>:5300/        -> LangBot
#   http://<GATEWAY_LAN_IP>:5300/sqlbot/ -> SqlBot
# LangBot itself is only published on loopback for debugging.

# ---- Images ----
# build-image.sh rewrites LANGBOT_IMAGE after every local build.
LANGBOT_IMAGE=langbot:local-CHANGEME
SQLBOT_IMAGE=sqlbot:1.10.3-383d972b7f24
PORTAL_GATEWAY_IMAGE=langbot-portal-gateway:CHANGEME
# build-image.sh rewrites this together with LANGBOT_IMAGE so Core and the
# Runtime always run the same revision. Keep them identical.
PLUGIN_RUNTIME_IMAGE=langbot:local-CHANGEME

# ---- Plugin runtime ----
# Shared control token for the external Plugin Runtime. Required for personal
# Workspaces to install plugins: Core resolves ``plugin.runtime_profile=auto``
# to ``shared`` only when this secret is set on both Core and Runtime.
# Generate with: openssl rand -hex 32
LANGBOT_PLUGIN_RUNTIME_CONTROL_TOKEN=

# ---- Persistent data ----
# Absolute paths are recommended so the compose file can be run from anywhere.
# Existing local stack uses:
#   LANGBOT_DATA_DIR=<repo>/data/docker
#   SQLBOT_DATA_DIR=<SQLBot repo>/data
LANGBOT_DATA_DIR=/absolute/path/to/LangBot/data/docker
SQLBOT_DATA_DIR=/absolute/path/to/SQLBot/data
TZ=Asia/Shanghai

# ---- Ports ----
# Browser-facing IP of this machine (must exist on a host interface and must
# not be 127.0.0.1; loopback is published automatically as a second mapping).
GATEWAY_LAN_IP=192.168.1.10
GATEWAY_HTTP_PORT=5300
# Loopback debug port for LangBot; browsers should use the gateway.
LANGBOT_DEBUG_PORT=5302
SQLBOT_HTTP_PORT=8010
SQLBOT_MCP_PORT=8011
PLUGIN_DEBUG_PORT=5401

# ---- Application center ----
PUBLIC_ORIGIN=http://127.0.0.1:5300
PORTAL_ENABLED=true
PORTAL_SQLBOT_ENABLED=true
LANGBOT_WEBHOOK_PREFIX=http://127.0.0.1:5300

# ---- LangBot -> SqlBot single sign-on ----
# Must equal LANGBOT_SSO_SHARED_SECRET below and sqlbot.sso.shared_secret in
# data/docker/config.yaml. Generate with: openssl rand -hex 32
SQLBOT_SSO_SHARED_SECRET=
# Give each new SSO account an empty personal workspace it administers.
SQLBOT_SSO_PERSONAL_WORKSPACE=true
# Embedded PostgreSQL password for this local SqlBot.
SQLBOT_POSTGRES_PASSWORD=
